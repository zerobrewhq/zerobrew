#!/data/data/com.termux/files/usr/bin/bash
# clang shim for Termux: rewrites the unversioned Android target triple
# (aarch64-linux-android) to the versioned one (aarch64-linux-android24)
# that newer Termux clang requires.
args=()
for a in "$@"; do
  if [[ "$a" == "--target=aarch64-linux-android" ]]; then
    # args+=("--target=aarch64-linux-android24")
    args+=("--target=aarch64-linux-android${TERMUX_APP__TARGET_SDK}")
  else
    args+=("$a")
  fi
done
exec "$TERMUX__PREFIX/bin/clang" "${args[@]}"
